# Get a free token at https://dashboard.audd.io/ (300 free requests, no card).
# Without a token the app falls back to AudD's anonymous access,
# which is limited to ~10 requests per day.
AUDD_API_TOKEN=

# Optional: ACRCloud humming project (14-day trial at https://console.acrcloud.com/).
# Create a project with the Humming engine and paste host / key / secret.
# ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=

# Port for the backend API server (optional, defaults to 3001)
PORT=3001
