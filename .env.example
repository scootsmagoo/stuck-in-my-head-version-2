# ---------------------------------------------------------------------------
# Local development only. The deployed GitHub Pages build ships NO token and
# uses AudD's anonymous tier (~10 requests/day), so nothing here is published.
# ---------------------------------------------------------------------------

# Used by the browser app. Get a free token at https://dashboard.audd.io/
# (300 requests, no card). Vite inlines this into the bundle at build time, so
# NEVER set it as a GitHub Actions secret — that would publish it.
VITE_AUDD_API_TOKEN=

# Used only by the optional Express server (npm run dev -w server), which keeps
# the token server-side. Safe to host anywhere that runs Node.
AUDD_API_TOKEN=

# Optional ACRCloud humming project (14-day trial at https://console.acrcloud.com/).
# Server-only: it signs requests with a secret, so it cannot run in the browser.
# ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=

# Port for the optional backend API server (defaults to 3001)
PORT=3001
